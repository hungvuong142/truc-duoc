# Copy this file to .streamlit/secrets.toml (gitignored) and fill in the
# real value. Without this file/secret, the app falls back to a local
# SQLite file at data/app.db -- no setup needed for local development.
#
# Get this connection string from Supabase: click "Connect" at the top of
# your project dashboard -> Direct connection -> "Session pooler" (IPv4-
# compatible, works from Streamlit Community Cloud).
DATABASE_URL = "postgresql://postgres:[password]@[host]:[port]/postgres"
